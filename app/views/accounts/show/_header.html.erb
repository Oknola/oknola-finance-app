<%# locals: (account:, title:, subtitle: nil) %>

<header class="space-y-4">
  <div class="flex min-w-0 items-center gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <%= render "accounts/logo", account: account %>

      <div class="flex min-w-0 items-center gap-2">
        <div class="min-w-0">
          <div class="flex min-w-0 items-center gap-3">
            <h2 class="min-w-0 flex-1 font-medium text-xl truncate <%= "animate-pulse" if account.syncing? %>"><%= title %></h2>
            <% if account.shared? %>
              <%= icon("users", class: "w-4 h-4 shrink-0 text-secondary", title: account.owned_by?(Current.user) ? nil : account.owner&.display_name) %>
            <% end %>
            <% if account.tax_treatment.present? %>
              <span class="shrink-0"><%= render partial: "accounts/tax_treatment_badge", locals: { account: account } %></span>
            <% end %>
            <% if account.draft? %>
              <%= render DS::Link.new(
                  text: t(".complete_setup"),
                  href: edit_account_path(account),
                  variant: :outline,
                  size: :sm,
                  frame: :modal
                ) %>
            <% end %>
          </div>
          <% if subtitle.present? %>
            <p class="text-sm text-secondary"><%= subtitle %></p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      <% if Rails.env.development? || self_hosted? %>
        <%= icon(
            "refresh-cw",
            as_button: true,
            size: "sm",
            href: sync_path_for(account),
            disabled: account.syncing?,
            frame: :_top
          ) %>
      <% end %>

      <%= render "accounts/show/menu", account: account %>
    </div>
  </div>
</header>
