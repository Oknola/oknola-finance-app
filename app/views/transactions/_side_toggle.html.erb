<% side = q["side"] %>
<% other_q = q.except("side") %>

<%= render DS::SegmentedControl.new(aria_label: t("transactions.side_toggle.aria")) do |control| %>
  <% control.with_segment(
       t("transactions.side_toggle.all"),
       active: side.blank?,
       href: transactions_path(q: other_q, page: 1)
     ) %>
  <% Oknola::Side::NAMES.each do |name| %>
    <% control.with_segment(
         t("transactions.side_toggle.#{name.downcase}"),
         active: side == name.downcase,
         href: transactions_path(q: other_q.merge("side" => name.downcase), page: 1)
       ) %>
  <% end %>
<% end %>
